---
import type { GearView } from "@/lib/repo";
import { formatCurrency } from "@/lib/logic";
import { GearStatusBadge } from "@/components/StatusBadge";

interface Props {
  gear: GearView;
}
const { gear } = Astro.props;
---

<a
  href={`/gear/${gear.id}`}
  class="card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-md"
>
  <div class="flex h-36 items-center justify-center overflow-hidden bg-gradient-to-br from-pine-100 to-sand-100 text-6xl">
    {gear.imageKey ? (
      <img
        src={`/api/images/${gear.imageKey}`}
        alt={gear.name}
        loading="lazy"
        class="h-full w-full object-cover transition group-hover:scale-105"
      />
    ) : (
      <span aria-hidden="true">{gear.emoji}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-pine-500">
          {gear.category?.name ?? "Gear"}
        </p>
        <h3 class="font-semibold text-pine-950 group-hover:text-pine-700">{gear.name}</h3>
      </div>
      <GearStatusBadge status={gear.status} />
    </div>
    <p class="mt-1 line-clamp-2 text-sm text-pine-700/70">{gear.description}</p>
    <div class="mt-auto flex items-end justify-between pt-4">
      <div>
        <span class="text-lg font-bold text-pine-900">{formatCurrency(gear.dailyPrice)}</span>
        <span class="text-sm text-pine-600">/day</span>
      </div>
      <span class="text-xs text-pine-500">📍 {gear.hub?.name ?? "In transit"}</span>
    </div>
  </div>
</a>
